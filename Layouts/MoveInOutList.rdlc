  <Code>'****DivideValues START****'
Public Function DivideValues(Value1 as decimal, Value2 as decimal)
  If Value2 = 0 then
    Return("")
  End if 
    Return (Value1 / Value2)
End Function
'****DivideValues END****'

'****Set and GetData Simplified START****'
Shared HeaderData As Object

Public Function GetData(Num As Integer) As Object
   Return Cstr(Choose(Num, Split(Cstr(HeaderData),Chr(177))))
End Function

Public Function SetData(NewData As Object) As Boolean
    HeaderData = NewData
  Return True
End Function
'****Set and GetData Simplified END****'

'****WordBlankZero issue START****'
Public Function WordBlankZero(ByVal Value As Decimal)
if Value = 0 then
Return "     "
end if
Return Value
End Function
'****WordBlankZero issue END****'

'****Double START****'
Private ChangeMeDouble As Double = 0

Public Function SetChangeMeDouble(ByVal val As Double) As Double
    ChangeMeDouble = val
    Return val
End Function

Public Function GetChangeMeDouble() As Double
    Return ChangeMeDouble
End Function
'****Double END****'

'****Boolean START****'
Private ChangeMeBoolean As Boolean = 0

Public Function SetChangeMeBoolean(ByVal val As Boolean) As Boolean
    ChangeMeBoolean = val
    Return val
End Function

Public Function GetChangeMeBoolean() As Boolean
    Return ChangeMeBoolean
End Function
'****Boolean END****'</Code>
